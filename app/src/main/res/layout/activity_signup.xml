<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_background">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/loginLbl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/luckiest_guy"
                android:gravity="center"
                android:paddingTop="50dp"
                android:paddingBottom="30dp"
                android:text="CREATE \n ACCOUNT"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="48sp"
                android:textStyle="bold" />

            <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="32dp"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="32dp">

                <RadioButton
                    android:id="@+id/donorBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="32dp"
                    android:layout_marginEnd="32dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/luckiest_guy"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:text="Donor" />

                <RadioButton
                    android:id="@+id/recipientBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="32dp"
                    android:layout_marginEnd="32dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/luckiest_guy"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:text="Recipient" />
            </RadioGroup>

            <EditText
                android:id="@+id/fullnameTxt"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="32dp"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="32dp"
                android:background="@drawable/edittext_background"
                android:drawableStart="@drawable/name"
                android:drawablePadding="24dp"
                android:ems="10"
                android:fontFamily="@font/luckiest_guy"
                android:hint="Enter Your Fullname"
                android:inputType="textPersonName"
                android:padding="8dp"
                android:text="Fullname"
                android:textColor="@color/white" />

            <EditText
                android:id="@+id/usernameTxt"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="32dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="32dp"
                android:background="@drawable/edittext_background"
                android:drawableStart="@drawable/name"
                android:drawablePadding="24dp"
                android:ems="10"
                android:fontFamily="@font/luckiest_guy"
                android:hint="Enter A Username"
                android:inputType="text"
                android:padding="8dp"
                android:text="Username"
                android:textColor="@color/white" />

            <EditText
                android:id="@+id/cellphoneTxt"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="32dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="32dp"
                android:background="@drawable/edittext_background"
                android:drawableStart="@drawable/ic_3"
                android:drawablePadding="12dp"
                android:ems="10"
                android:fontFamily="@font/luckiest_guy"
                android:hint="Enter Your Cellphone Number"
                android:inputType="phone"
                android:padding="8dp"
                android:text="Cellphone"
                android:textColor="@color/white" />

            <EditText
                android:id="@+id/Address"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="32dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="32dp"
                android:background="@drawable/edittext_background"
                android:drawableStart="@drawable/ic_2"
                android:drawablePadding="12dp"
                android:ems="10"
                android:fontFamily="@font/luckiest_guy"
                android:hint="Enter Your Address"
                android:inputType="textEmailAddress"
                android:padding="8dp"
                android:text="Address"
                android:textColor="@color/white" />

            <EditText
                android:id="@+id/IdentificationNo"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="32dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="32dp"
                android:background="@drawable/edittext_background"
                android:drawablePadding="16dp"
                android:ems="10"
                android:fontFamily="@font/luckiest_guy"
                android:hint="Enter Your ID number"
                android:inputType="text|number"
                android:padding="8dp"
                android:text="ID Number"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/imageView3"
                android:layout_width="146dp"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="32dp"
                android:background="#F3CF1A"
                android:fontFamily="@font/luckiest_guy"
                android:text='ENTER'
                android:textAppearance="@style/TextAppearance.AppCompat.Display1"
                android:textColor="@color/black"
                app:srcCompat="@color/yellow" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>