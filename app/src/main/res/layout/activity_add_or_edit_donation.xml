<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/login_background">

    <!-- SUPPLY DROP Title -->
    <TextView
        android:id="@+id/appTitleLbl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/luckiest_guy"
        android:text="SUPPLY DROP"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:paddingTop="20dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Subtitle -->
    <TextView
        android:id="@+id/subTitleLbl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/luckiest_guy"
        android:text="ADD / EDIT DONATION"
        android:textColor="@color/yellow"
        android:textSize="18sp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/appTitleLbl"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Divider -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#44ffffff"
        app:layout_constraintTop_toBottomOf="@id/subTitleLbl"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Scrollable form content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Item Name -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ITEM / RECIPIENT NAME"
                android:textColor="@color/white"
                android:fontFamily="@font/luckiest_guy"
                android:textSize="14sp"
                android:paddingBottom="4dp"/>

            <EditText
                android:id="@+id/itemNameEt"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/edittext_background"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:hint="e.g. Winter Jackets for Hope Foundation"
                android:inputType="text"
                android:textColor="@color/white"
                android:textColorHint="#88ffffff"
                android:fontFamily="@font/luckiest_guy"/>

            <!-- Image Upload -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ITEM IMAGE"
                android:textColor="@color/white"
                android:fontFamily="@font/luckiest_guy"
                android:textSize="14sp"
                android:paddingTop="16dp"
                android:paddingBottom="4dp"/>

            <!-- Image Preview -->
            <ImageView
                android:id="@+id/itemImageView"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:background="#44ffffff"
                android:scaleType="centerCrop"
                android:src="@drawable/account_circle"/>

            <Button
                android:id="@+id/changeImageBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:text="Choose Image"
                android:fontFamily="@font/luckiest_guy"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:background="@color/yellow"
                app:backgroundTint="@null"/>

            <!-- Description -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DESCRIPTION"
                android:textColor="@color/white"
                android:fontFamily="@font/luckiest_guy"
                android:textSize="14sp"
                android:paddingTop="16dp"
                android:paddingBottom="4dp"/>

            <EditText
                android:id="@+id/descriptionEt"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@drawable/edittext_background"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:hint="Describe what you need and why..."
                android:inputType="textMultiLine"
                android:gravity="top"
                android:textColor="@color/white"
                android:textColorHint="#88ffffff"
                android:fontFamily="@font/luckiest_guy"/>

            <!-- Category -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CATEGORY"
                android:textColor="@color/white"
                android:fontFamily="@font/luckiest_guy"
                android:textSize="14sp"
                android:paddingTop="16dp"
                android:paddingBottom="4dp"/>

            <Spinner
                android:id="@+id/categorySpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/edittext_background"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:popupBackground="#1a1a2e"/>

            <!-- Quantity -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="QUANTITY NEEDED"
                android:textColor="@color/white"
                android:fontFamily="@font/luckiest_guy"
                android:textSize="14sp"
                android:paddingTop="16dp"
                android:paddingBottom="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/decreaseQtyBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="-"
                    android:textSize="18sp"
                    android:fontFamily="@font/luckiest_guy"
                    android:textColor="@color/white"
                    android:background="@color/lblue"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    app:backgroundTint="@null"/>

                <EditText
                    android:id="@+id/quantityTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="1"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:fontFamily="@font/luckiest_guy"
                    android:gravity="center"
                    android:inputType="number"
                    android:background="@null"
                    android:textColorHint="#88ffffff"
                    android:hint="1"/>

                <Button
                    android:id="@+id/increaseQtyBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="+"
                    android:textSize="18sp"
                    android:fontFamily="@font/luckiest_guy"
                    android:textColor="@color/white"
                    android:background="@color/lblue"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    app:backgroundTint="@null"/>

            </LinearLayout>

            <!-- Save Button -->
            <Button
                android:id="@+id/saveBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                android:text="SAVE"
                android:fontFamily="@font/luckiest_guy"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:background="@color/yellow"
                app:backgroundTint="@null"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>