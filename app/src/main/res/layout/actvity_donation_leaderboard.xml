<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_background">

    <!-- Title -->
    <TextView
        android:id="@+id/appTitleLbl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/luckiest_guy"
        android:text="SUPPLY DROP"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:paddingTop="20dp"
        android:paddingStart="16dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/subTitleLbl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/luckiest_guy"
        android:text="DONATION LEADERBOARD"
        android:textColor="@color/yellow"
        android:textSize="18sp"
        android:paddingStart="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/appTitleLbl"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Divider -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#44ffffff"
        app:layout_constraintTop_toBottomOf="@id/subTitleLbl"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Search + Clear -->
    <EditText
        android:id="@+id/usernameSearch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/edittext_background"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:hint="Search by username..."
        android:textColorHint="#88ffffff"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:inputType="text"
        android:imeOptions="actionDone"
        android:fontFamily="@font/luckiest_guy"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/clearBtn"/>

    <Button
        android:id="@+id/clearBtn"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:text="Clear"
        android:fontFamily="@font/luckiest_guy"
        android:textColor="@color/black"
        android:textSize="12sp"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:background="@color/yellow"
        app:backgroundTint="@null"
        app:layout_constraintTop_toTopOf="@id/usernameSearch"
        app:layout_constraintBottom_toBottomOf="@id/usernameSearch"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/usernameSearch"/>

    <!-- Table Header -->
    <LinearLayout
        android:id="@+id/tableHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#AA000000"
        android:layout_marginTop="12dp"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/usernameSearch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="POS."
            android:textColor="@color/white"
            android:textStyle="bold"
            android:fontFamily="@font/luckiest_guy"
            android:textSize="16sp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:text="USERNAME"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:fontFamily="@font/luckiest_guy"
            android:textSize="16sp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="DONATIONS"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:fontFamily="@font/luckiest_guy"
            android:textSize="16sp"/>

    </LinearLayout>

    <!-- Leaderboard List -->
    <ListView
        android:id="@+id/leaderboardListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:divider="#44ffffff"
        android:dividerHeight="1dp"
        app:layout_constraintTop_toBottomOf="@id/tableHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>