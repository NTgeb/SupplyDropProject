<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/login_background">

    <!-- Top Bar -->
    <TextView
        android:id="@+id/appTitleLbl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/luckiest_guy"
        android:text="SUPPLY DROP"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:paddingTop="20dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Divider -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#44ffffff"
        app:layout_constraintTop_toBottomOf="@id/appTitleLbl"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Action Buttons -->
    <Button
        android:id="@+id/addBtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="4dp"
        android:text="Add"
        android:fontFamily="@font/luckiest_guy"
        android:textColor="@color/black"
        android:textSize="12sp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:minHeight="30dp"
        android:minWidth="0dp"
        android:background="@color/yellow"
        app:backgroundTint="@null"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/editBtn"/>

    <Button
        android:id="@+id/editBtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="4dp"
        android:text="Edit"
        android:fontFamily="@font/luckiest_guy"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:minHeight="30dp"
        android:minWidth="0dp"
        android:background="#AA000000"
        app:backgroundTint="@null"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toEndOf="@id/addBtn"
        app:layout_constraintEnd_toStartOf="@id/removeBtn"/>

    <Button
        android:id="@+id/removeBtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:text="Remove"
        android:fontFamily="@font/luckiest_guy"
        android:textColor="@color/black"
        android:textSize="12sp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:minHeight="30dp"
        android:minWidth="0dp"
        android:background="#b22222"
        app:backgroundTint="@null"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toEndOf="@id/editBtn"
        app:layout_constraintEnd_toEndOf="parent"/>
    <!-- Table Header -->
    <LinearLayout
        android:id="@+id/tableHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#AA000000"
        android:layout_marginTop="12dp"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/editBtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="ITEM"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:fontFamily="@font/luckiest_guy"
            android:textSize="16sp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="CATEGORY"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:fontFamily="@font/luckiest_guy"
            android:textSize="16sp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="QTY"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:fontFamily="@font/luckiest_guy"
            android:textSize="16sp"/>

    </LinearLayout>

    <!-- Donation Requests Table -->
    <ListView
        android:id="@+id/donationRequestsListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:divider="#44ffffff"
        android:dividerHeight="1dp"
        app:layout_constraintTop_toBottomOf="@id/tableHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>